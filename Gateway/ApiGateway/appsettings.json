      "ReverseProxy": {
        "Routes": {
          "ticket-route": {
            "ClusterId": "ticket-cluster",
            "Match": {
              "Path": "/api/tickets/{**catch-all}"
            }
          },
          "customer-route": {
            "ClusterId": "customer-cluster",
            "Match": {
              "Path": "/api/customers/{**catch-all}"
            }
          }
        },
        "Clusters": {
          "ticket-cluster": {
            "Destinations": {
              "ticket-api": {
                "Address": "http://localhost:5186/"
              }
            }
          },
          "customer-cluster": {
            "Destinations": {
              "customer-api": {
                "Address": "http://localhost:5187/"
              }
            }
          }
        }
      }
    
  },
  "AllowedHosts": "*"
}
