{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Yarp.ReverseProxy": "Debug"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "ticket-route": {
        "ClusterId": "ticket-cluster",
        "Match": {
          "Path": "/api/tickets/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/Ticket/{**catch-all}"
          }
        ]
      },
      "customer-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "ticket-cluster": {
        "Destinations": {
          "ticket-api": {
            "Address": "http://host.docker.internal:5186/"
          }
        }
      },
      "customer-cluster": {
        "Destinations": {
          "customer-api": {
            "Address": "http://host.docker.internal:7024/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}